{
  "format": 1,
  "id": "marine",
  "version": 1,
  "name": "Sea state",
  "description": "Wave, swell and sea-surface conditions at your location. Only meaningful on or near the coast.",
  "author": "Omniscope",
  "source": "Open-Meteo Marine",
  "category": "conditions",
  "icon": "wind",
  "cost": "free",
  "freshness": "slow",
  "preload": false,
  "tags": ["sea", "waves", "weather"],
  "ambient": true,
  "hosts": ["marine-api.open-meteo.com"],
  "request": {
    "url": "https://marine-api.open-meteo.com/v1/marine?latitude={lat}&longitude={lon}&current=wave_height,wave_direction,wave_period,swell_wave_height,sea_surface_temperature,ocean_current_velocity"
  },
  "items": "$.current",
  "item": {
    "id": "'now'",
    "title": "$.wave_height | round1 | prefix:'Waves ' | suffix: m || 'Sea state: no marine data here'",
    "subtitle": "$.sea_surface_temperature | round1 | prefix:'Sea ' | suffix: °C",
    "fields": [
      ["Wave height", "$.wave_height | round1 | suffix: m"],
      ["Wave period", "$.wave_period | round1 | suffix: s"],
      ["Wave direction", "$.wave_direction | compass"],
      ["Swell height", "$.swell_wave_height | round1 | suffix: m"],
      ["Sea temperature", "$.sea_surface_temperature | round1 | suffix: °C"],
      ["Current", "$.ocean_current_velocity | round1 | suffix: km/h"]
    ]
  }
}
